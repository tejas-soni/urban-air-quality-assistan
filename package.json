{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "description": "BreatheWise — GenAI Urban Air Quality Assistant with live AQI fallbacks, WHO/EPA RAG citations, and persona-tailored guidance.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src tests e2e --max-warnings 0",
    "lint:fix": "eslint src tests e2e --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "audit:complexity": "node audit.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:cov && npm run build",
    "check": "npm run verify"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.128",
    "@ai-sdk/react": "^4.0.188",
    "ai": "^7.0.183",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.10.3",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "vitest-axe": "^0.1.0"
  }
}
