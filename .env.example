# Environment Variables for BreatheWise — Urban Air Quality Assistant
# Copy to .env.local (for local Next.js dev) and set in Vercel Project Settings.
# Never commit real API keys!

# Required for live Gemini AI streaming (optional — app falls back cleanly to local RAG if unset)
GEMINI_API_KEY=

# Optional AQI Data Providers (server-side only; 60-min cached; falls back cleanly across providers)
IQAIR_API_KEY=
OPENWEATHER_API_KEY=
OPENAQ_API_KEY=
AIRNOW_API_KEY=
